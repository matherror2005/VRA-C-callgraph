{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRA Function Call Graph v1",
  "description": "v3 整项目接口的输出格式。graph_export.validate_call_graph 校验本契约的字段形状和跨记录约束；规则见 docs/CALL_GRAPH_SCHEMA.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "directed",
    "metadata",
    "nodes",
    "edges",
    "call_sites",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "directed": {
      "const": true
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "call_sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/call_site"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "language",
        "repo",
        "location",
        "translation_unit",
        "is_static",
        "build_target",
        "build_configuration_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "function"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "translation_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "is_static": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "build_target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "build_configuration_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "call_site_ids",
        "is_cross_repo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "calls"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "call_site_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "is_cross_repo": {
          "type": "boolean"
        }
      }
    },
    "call_site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "caller_id",
        "callee_id",
        "callee_name",
        "expression",
        "location",
        "resolution",
        "candidate_ids",
        "reason",
        "evidence",
        "linker_verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "caller_id": {
          "type": "string",
          "minLength": 1
        },
        "callee_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "callee_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "resolution": {
          "enum": [
            "matched",
            "unresolved",
            "ambiguous",
            "indirect"
          ]
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "linker_verified": {
          "type": "boolean"
        },
        "attributes": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "matched"
              }
            },
            "required": [
              "resolution"
            ]
          },
          "then": {
            "properties": {
              "callee_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_ids": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "callee_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "revision",
        "frontend",
        "languages",
        "build_configuration_id",
        "build_root_target",
        "matching_policy",
        "linker_verified"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "frontend": {
          "enum": [
            "clang",
            "tree-sitter"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "build_configuration_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "build_root_target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "matching_policy": {
          "const": "matched_edges_only"
        },
        "linker_verified": {
          "type": "boolean"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "location"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
